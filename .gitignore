# ── AstrBot / Quill 运行数据（含隐私，一律不入库）──
# 运行数据自 v5.2.4 起移出插件目录，改由 _paths.py 存到
#   <AstrBot data>/plugin_data/astrbot_plugin_quillplus/
# 下列规则同时兜住「新数据目录被误放进仓库」与「旧布局残留」两种情况。
data/
imports/
data_runtime/

# knowledge/ 素材库残留（v5.3 精简：KB 提案/条目文档移入 .backup/，不入公开库）
knowledge/

# 数据库及其 sidecar：-wal 里可能有未 checkpoint 的已提交事务，同样不能入库
*.db
*.db-wal
*.db-shm
*.db-journal
*.index

# 世界书：只保留随仓库分发的示例模板，用户自己的世界书不入库
worldbooks/*.json
!worldbooks/示例世界书.json

# ── MCP 配置（可能含 API Key） ──
.mcp.json
.mcp/

# ── 环境变量 / 密钥 ──
.env
.env.*
*.pem
*.key

# ── 临时/备份文件 ──
*.tmp
*.bak
*.log
logs/
_commit_msg.txt

# ── 排除 __pycache__ 下的 .pyc（双重保险） ──
*.pyc

# ── 测试产物 ──
.pytest_cache/
.coverage
htmlcov/
.tox/

.reasonix/
.zcode/

# ── 前端重写前的原始版本备份（本地保留，不入库）──
.backup/

# ── 前端重写构建中间产物 ──
.build/

# 本地测试令牌（不得提交）
.test_api_token.txt
.test_asset_token.txt
.test_jwt.txt

# ── 开发期产物（v5.3 精简：公开仓库只留运行/用户所需，开发件本地保留）──
# 精简范围与理由见 docs/v5.3/BASELINE.md（本地文档）与本次提交说明。
docs/
tests/
tools/
pytest.ini
requirements-ci.txt
.github/workflows/
